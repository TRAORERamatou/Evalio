# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port exposed by the Express server
PORT=3000

# MongoDB local or Atlas connection string (never commit real credentials)
MONGODB_URI=mongodb://127.0.0.1:27017/evalio

# Minimum 32 chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=

# HYPOTHESE TODO (API Lead): uncomment when refresh tokens and CORS are wired in env.ts
# JWT_REFRESH_SECRET=
# CORS_ORIGIN=http://localhost:3000
